# Portfolio pre-push hook (Husky). A push to main deploys the live site, so check first.
# 1. Always: the PhoneRecap legal text still matches the app repo (fast).
# 2. Unless only docs/tools changed: a full production build (~2-3 min).
# Skip once:  SKIP_PREPUSH=1 git push   (PowerShell: $env:SKIP_PREPUSH=1; git push; Remove-Item Env:SKIP_PREPUSH)
# PREPUSH_DRY_RUN=1 only prints the decision.

if [ "${SKIP_PREPUSH:-}" = "1" ]; then
  echo "pre-push: SKIPPED (SKIP_PREPUSH=1). Legal sync and build did not run."
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

# Git sends one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
ZERO=0000000000000000000000000000000000000000
changed=""
unknown=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue # deleting a remote ref: nothing to check
  case "$local_ref" in refs/tags/*) continue ;; esac
  if [ "$remote_sha" = "$ZERO" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    # New branch: compare with origin/main when we have it.
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null) || { unknown=1; continue; }
    remote_sha=$base
  fi
  files=$(git diff --name-only "$remote_sha" "$local_sha") || { unknown=1; continue; }
  changed="$changed
$files"
done

# Files that never change the built site.
docs_only=0
if [ "$unknown" -eq 0 ] && [ -n "$(printf '%s' "$changed" | tr -d '[:space:]')" ]; then
  # `|| true`: Husky runs this with `sh -e`, and grep exits 1 when nothing is left.
  site=$(printf '%s\n' "$changed" | grep -v '^$' |
    grep -v -E '^(CLAUDE\.md|README\.md|LICENSE|\.gitignore|\.editorconfig|\.claude/|\.husky/|tools/)' || true)
  [ -z "$site" ] && docs_only=1
fi

if [ "${PREPUSH_DRY_RUN:-}" = "1" ]; then
  if [ "$docs_only" -eq 1 ]; then
    echo "pre-push: would run legal sync only (docs/tools changes)."
  else
    echo "pre-push: would run legal sync and npm run build (site or unknown changes)."
  fi
  exit 0
fi

node tools/checks/legal-sync.js || {
  echo "pre-push: PhoneRecap legal text differs from the app repo, push stopped."
  exit 1
}

if [ "$docs_only" -eq 1 ]; then
  echo "pre-push: docs/tools only, build skipped."
  exit 0
fi

echo "pre-push: npm run build (skip once with SKIP_PREPUSH=1 git push)"
npm run build --silent >/dev/null 2>&1 || {
  echo "pre-push: npm run build failed, push stopped. Run it to see the error, or push once with SKIP_PREPUSH=1."
  exit 1
}
echo "pre-push: build passed."
